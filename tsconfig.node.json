{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "node_modules/.tmp/tsconfig-node",
    "emitDeclarationOnly": true
  },
  "include": ["vite.config.ts", "src/seo.ts", "src/components/Data/projectDetails.ts"]
}
